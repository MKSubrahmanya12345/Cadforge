# Client environment. Vite only exposes variables prefixed with VITE_ to the
# browser, and only these are safe to expose: never put a secret here.
#
# Copy this file to client/.env only if you are serving the built client from a
# different origin than the API. In development Vite proxies /api and /files to
# the server, so this file is not needed at all.

# Where the CADForge API lives. Leave empty to use the current origin (which is
# what the dev proxy and a same-origin deployment both want).
#   VITE_API_URL=https://cadforge-api.onrender.com
VITE_API_URL=
